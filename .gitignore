# ── Environment variables ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Firebase / secrets ───────────────────────────────────────────────────────
scripts/serviceAccountKey.json
*.pem
*.key
*.p12
*.p8
*.jks
*.mobileprovision

# ── Expo / React Native ──────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
app-example

# ── Native build output ──────────────────────────────────────────────────────
/ios
/android
.kotlin/
*.orig.*

# ── Terraform ────────────────────────────────────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
# A saved plan is a zip that embeds the whole state, secrets included — the
# rules above do not catch it, because it is not named *.tfstate.
tfplan
*.tfplan
*.tfplan.*

# ── Firebase CLI ─────────────────────────────────────────────────────────────
.firebase/

# ── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ── OS generated ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
