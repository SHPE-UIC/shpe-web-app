# Backend (.env at the repo root) — read by backend/src/env.ts
# The Expo app has its own file; see frontend/example.env

PORT=5000

# ── Required ────────────────────────────────────────────────────────────────

# Neon Postgres. In the Vercel dashboard: Storage > your Neon database >
# "Connect", then copy the pooled connection string. Locally you can point this
# at any Postgres instance.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Signs session tokens and check-in QR tokens. Any long random string — e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every member out.
JWT_SECRET=replace-me-with-a-long-random-string

# ── API access ──────────────────────────────────────────────────────────────

# Comma-separated browser origins allowed to call this API. Add Vercel preview
# URLs here rather than loosening the check in code. Empty in local development
# allows any origin.
CORS_ORIGINS=https://your-app.vercel.app

# How long a member stays signed in.
SESSION_TTL=7d

# Lifetime of a check-in QR token, in seconds. Short on purpose: a screenshot of
# the projected code must stop working long before the event ends.
CHECKIN_TOKEN_TTL_SECONDS=60

# ── Google Calendar sync (optional — the API boots fine without it) ──────────

# The shared calendar to sync from. Google Calendar >
# Settings > [your calendar] > Integrate calendar > Calendar ID.
GOOGLE_CALENDAR_ID=abc123@group.calendar.google.com

# Service account JSON from Google Cloud Console. Share the calendar with this
# account's client_email (read access) and enable the Google Calendar API in the
# same project. Locally, point at the downloaded file:
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# On Render, paste the whole key file as one line instead. Set one or the other.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# How often the running server polls the calendar for changes.
CALENDAR_SYNC_INTERVAL_MINUTES=15

# Set to 1 to disable the in-process poll loop and rely only on the endpoint.
# DISABLE_SYNC_LOOP=1

# Shared secret for POST /api/sync/calendar, sent as the x-sync-secret header.
# Required in production. Leave unset locally and the endpoint stays open.
# SYNC_SECRET=some-long-random-string
