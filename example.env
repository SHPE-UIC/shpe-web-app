# Backend (.env at the repo root) — read by backend/server.js
# The Expo app has its own file; see frontend/example.env

PORT=5000

# The shared calendar to sync from. Find it in Google Calendar under
# Settings > [your calendar] > Integrate calendar > Calendar ID.
GOOGLE_CALENDAR_ID=abc123@group.calendar.google.com

# Service account JSON, downloaded from Firebase Console >
# Project settings > Service accounts > Generate new private key.
# Share the calendar with this account's client_email (read access), and
# enable the Google Calendar API in the same Cloud project.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# Alternative to the path above, for hosts with no filesystem to put a key on:
# paste the entire key file as a single line. Set one or the other, not both.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# How often to poll the calendar for changes. Note this in-process timer stops
# whenever the host suspends an idle instance (Render's free tier does after
# 15 minutes) — see SYNC_SECRET below.
CALENDAR_SYNC_INTERVAL_MINUTES=15

# Shared secret for POST /api/sync/calendar, sent as the x-sync-secret header.
# Required in production, where an external scheduler drives the sync. Leave it
# unset locally and the endpoint stays open.
# SYNC_SECRET=some-long-random-string

# Set to 1 to skip the in-process poll loop entirely and rely only on the
# endpoint. Sensible on a host that suspends idle instances.
# DISABLE_SYNC_LOOP=1
