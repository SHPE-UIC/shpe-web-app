# Backend (.env at the repo root) — read by backend/src/env.ts
# The Expo app has its own file; see frontend/example.env
#
# In production every value here comes from Terraform (infra/) via Secret
# Manager and Cloud Run env vars — this file is for local development only.

PORT=5000

# ── Required ────────────────────────────────────────────────────────────────

# Any Postgres instance locally. In production this is the Cloud SQL socket
# DSN that Terraform writes to Secret Manager.
DATABASE_URL=postgresql://user:password@localhost:5432/shpe

# Signs check-in QR tokens (member sessions are Firebase ID tokens now).
# Any long random string — e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CHECKIN_TOKEN_SECRET=replace-me-with-a-long-random-string

# ── Firebase Authentication ─────────────────────────────────────────────────

# The backend verifies ID tokens and creates users through the Admin SDK.
# On Cloud Run it uses the runtime service account automatically. Locally,
# run the Auth emulator (firebase emulators:start --only auth) and set:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GCLOUD_PROJECT=demo-shpe

# ── API access ──────────────────────────────────────────────────────────────

# Comma-separated browser origins allowed to call this API. Empty in local
# development allows any origin. In production Terraform sets the Firebase
# Hosting URLs.
CORS_ORIGINS=

# Lifetime of a check-in QR token, in seconds. Short on purpose: a screenshot of
# the projected code must stop working long before the event ends.
CHECKIN_TOKEN_TTL_SECONDS=60

# ── Google Calendar sync (optional — the API boots fine without it) ──────────

# The shared calendar to sync from. Google Calendar >
# Settings > [your calendar] > Integrate calendar > Calendar ID.
GOOGLE_CALENDAR_ID=abc123@group.calendar.google.com

# On GCP no key exists: the Cloud Run service account is used automatically
# (share the calendar with its email). Locally, either point at a downloaded
# key file or leave both unset if you don't need calendar sync:
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# How often the running server polls the calendar for changes.
CALENDAR_SYNC_INTERVAL_MINUTES=15

# Set to 1 to disable the in-process poll loop and rely only on the endpoint.
# Production sets this — Cloud Scheduler calls the endpoint instead.
# DISABLE_SYNC_LOOP=1

# Shared secret for POST /api/sync/calendar, sent as the x-sync-secret header.
# Required in production (Terraform generates it). Leave unset locally and the
# endpoint stays open.
# SYNC_SECRET=some-long-random-string
