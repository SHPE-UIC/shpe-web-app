# Expo app (frontend/.env) — read by frontend/lib/firebase.ts
# Values come from Firebase Console > Project settings > Your apps > Web app.
# The EXPO_PUBLIC_ prefix is required; Expo ignores any other name, and these
# values are inlined into the app bundle (which is expected for Firebase web
# config — Firestore/Storage rules are what actually protect your data).

EXPO_PUBLIC_FIREBASE_API_KEY=AIza...your_actual_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
