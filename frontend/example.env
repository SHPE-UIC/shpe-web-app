# Expo app (frontend/.env)
#
# The EXPO_PUBLIC_ prefix is required — Expo silently ignores any other name,
# and the app then fails at its first API call with no explanation. Values are
# inlined at build time, so restart with `npx expo start -c` after any change.

# The Render API. No trailing slash.
#   local:      http://localhost:5000
#   deployed:   https://your-service.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:5000
