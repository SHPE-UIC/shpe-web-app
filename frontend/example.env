# Expo app (frontend/.env)
#
# The EXPO_PUBLIC_ prefix is required — Expo silently ignores any other name,
# and the app then fails at its first API call with no explanation. Values are
# inlined at build time, so restart with `npx expo start -c` after any change.
# In CI these come from GitHub Actions variables (see infra/README.md).

# The API. No trailing slash.
#   local:      http://localhost:5000
#   deployed:   https://shpe-api-<hash>-uc.a.run.app  (terraform output api_url)
EXPO_PUBLIC_API_URL=http://localhost:5000

# Firebase web app config — public client identifiers, not secrets.
# From `terraform output firebase_web_config`, or the Firebase console under
# Project settings > Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc123
