{
  "name": "shpe-web-app",
  "version": "1.0.0",
  "description": "SHPE @ UIC member app — Express API, Postgres, and Google Calendar sync",
  "main": "backend/src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx backend/src/index.ts",
    "dev": "tsx watch backend/src/index.ts",
    "sync": "tsx backend/src/syncOnce.ts",
    "sync:full": "tsx backend/src/syncOnce.ts --full",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glech2/shpe-web-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/glech2/shpe-web-app/issues"
  },
  "homepage": "https://github.com/glech2/shpe-web-app#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
