{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // tsx resolves extensionless relative imports, so the backend does not have
    // to litter ESM ".js" suffixes across TypeScript source files.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["backend/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "frontend"]
}
